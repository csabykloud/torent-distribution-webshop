# Torent Distribution - Configurare Mediu (.env)
# Copiază acest fișier ca `.env` și completează datele reale ale serverului de email.

# Număr telefon suport afișat în bara de sus a site-ului
SUPPORT_PHONE=0740 000 000

# Adresa de email pe care intră solicitările B2B
B2B_TARGET_EMAIL=vanzari@torentdistribution.ro

# Date server SMTP (din cPanel / hosting email)
SMTP_HOST=mail.torentdistribution.ro
SMTP_PORT=587
SMTP_USER=vanzari@torentdistribution.ro
SMTP_PASSWORD=PAROLA_TA_SMTP_AICI
SMTP_USE_TLS=true
